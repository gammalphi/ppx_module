opam-version: "2.0"
synopsis: "PPX-generated module instantiation graphs"
maintainer: ["Paul Robert <paul.robert@cea.fr>"]
depends: [
  "dune" {>= "3.14"}
  "ppxlib" {>= "0.35.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
